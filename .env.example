# Route data location (CSV sample routes)
ROUTE_PATH=data/sample_routes

# PostgreSQL connection (matches docker-compose.yml for local dev)
DATABASE_URL=postgresql://pace:pace@localhost:5432/pace_yourself

# Fernet key used to encrypt per-user Strava grants.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_with_a_generated_fernet_key

# Strava API credentials (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# OAuth callback URL for this deployment. Its domain must be registered as the
# Strava app "Authorization Callback Domain". Local dev example below.
STRAVA_REDIRECT_URI=http://localhost:8501
